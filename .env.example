# Slack Bot Configuration
# Copy this file to .env and replace with your actual tokens

# Slack Bot User OAuth Token (starts with xoxb-)
# Get from: https://api.slack.com/apps → Your App → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack Signing Secret (REQUIRED for HTTP Mode)
# Get from: https://api.slack.com/apps → Your App → Basic Information → App Credentials
# Used for request signature verification to ensure requests are from Slack
SLACK_SIGNING_SECRET=your-signing-secret-here

# Application Port (optional, defaults to 3000)
PORT=3000

# ============================================
# SOCKET MODE ONLY (not needed for HTTP mode)
# ============================================
# Slack App-Level Token (starts with xapp-)
# Get from: https://api.slack.com/apps → Your App → Basic Information → App-Level Tokens
# Only required if running Socket Mode (index.js)
SLACK_APP_TOKEN=xapp-your-app-token-here